---
import AppLayout from '~/layouts/AppLayout.astro';
import PostEditor from '~/components/PostEditor.astro';
import { sql } from '~/lib/db';

const catRows = await sql`select category from posts`;
const categories = Array.from(new Set((catRows ?? []).map((c) => c.category).filter(Boolean))).sort() as string[];
---
<AppLayout title="New post · Chabad Central">
  <PostEditor mode="new" categories={categories} />
</AppLayout>
