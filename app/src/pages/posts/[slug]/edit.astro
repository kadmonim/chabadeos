---
import AppLayout from '~/layouts/AppLayout.astro';
import PostEditor from '~/components/PostEditor.astro';
import { sql } from '~/lib/db';

const { slug } = Astro.params;

const postRows = await sql`
  select p.*, p.date::text as date from posts p where p.slug = ${slug}`;
const post = postRows[0] ?? null;

if (!post) return new Response('Not found', { status: 404 });

const catRows = await sql`select category from posts`;
const categories = Array.from(new Set((catRows ?? []).map((c) => c.category).filter(Boolean))).sort() as string[];
---
<AppLayout title={`Edit · ${post.headline || 'post'} · Chabad Central`}>
  <PostEditor mode="edit" post={post} categories={categories} />
</AppLayout>
