---
import AppLayout from '~/layouts/AppLayout.astro';
import Drawer from '~/components/Drawer.astro';
import SegmentedTabs from '~/components/SegmentedTabs.astro';
import ContactForm from '~/components/crm/ContactForm.astro';
import ContactPicker from '~/components/crm/ContactPicker.svelte';
import FamilyPicker from '~/components/crm/FamilyPicker.svelte';
import TagPicker from '~/components/crm/TagPicker.svelte';
import HebrewDatePicker from '~/components/crm/HebrewDatePicker.svelte';
import { initials, fmtMoney } from '~/lib/crm/format';
import { whatsappUrl, telUrl } from '~/lib/crm/phone';
import { fmtDualDate, todayIso } from '~/lib/dates';
import {
  STAGES, STAGE_LABELS, STAGE_STYLES, HOUSEHOLD_ROLES, LINK_TYPES, LINK_LABELS,
  ACTIVITY_KINDS, ACTIVITY_LABELS, DATE_KINDS, DATE_KIND_LABELS,
} from '~/lib/crm/types';
import { getViewer, listEmployees, listCrmUsers, canManage } from '~/lib/crm/access';
import { getContact } from '~/lib/crm/contacts';
import { getHousehold } from '~/lib/crm/households';
import { listTags } from '~/lib/crm/tags';
import { listActivities, describeSystemEvent } from '~/lib/crm/activities';
import { listTasksForContact } from '~/lib/crm/tasks';
import { listDates } from '~/lib/crm/dates';
import {
  StickyNote, ListTodo, Phone, MessageCircle, Pencil, Copy, Users, Link2,
  Gift, ListChecks, Plus, X, ArrowRightLeft, Home, Sparkles, MoreVertical,
  Trash2, CalendarDays, Check,
} from 'lucide-svelte';

const ACTIVITY_ICONS: Record<string, typeof StickyNote> = {
  note: StickyNote, call: Phone, visit: Home, message: MessageCircle, meeting: Users, system: Sparkles,
};

// Relabel head → 'ראש המשפחה'; keep the rest from HOUSEHOLD_ROLE_LABELS.
const ROLE_LABELS: Record<string, string> = {
  head: 'ראש המשפחה',
  spouse: 'בן/בת זוג',
  child: 'ילד/ה',
  other: 'אחר',
};

const viewer = getViewer(Astro.locals);
if (!viewer) return Astro.redirect('/?crm=denied');

const { id } = Astro.params;
const contact = id ? await getContact(viewer, id) : null;
const family = contact?.household ? await getHousehold(viewer, contact.household.id) : null;
const allTags = await listTags();

const url = Astro.url;
const back = url.pathname + url.search;
const editing = url.searchParams.get('edit') === '1';
const err = url.searchParams.get('err');
const tab = url.searchParams.get('tab') ?? 'timeline';
const memberDrawer = url.searchParams.get('drawer') === 'member';
const memberRoleParam = url.searchParams.get('role') ?? 'spouse';
const memberRole = (HOUSEHOLD_ROLES as readonly string[]).includes(memberRoleParam) ? memberRoleParam : 'spouse';
const familyDrawer = url.searchParams.get('drawer') === 'family';
const linkDrawer = url.searchParams.get('drawer') === 'link';
const dateDrawer = url.searchParams.get('drawer') === 'date';
const suggestFamilyId = url.searchParams.get('suggest_family');
const compose = url.searchParams.get('compose') === '1';

// ---------------------------------------------------------------------------
// Phase 3: timeline / tasks / dates data
// ---------------------------------------------------------------------------
const beforeCursor = url.searchParams.get('before');
const timelineData = contact
  ? await listActivities(viewer, contact.id, { limit: 30, before: beforeCursor || null })
  : { items: [], next: null };
const tasksData = contact ? await listTasksForContact(viewer, contact.id, { includeDone: true }) : [];
const openTasksList = tasksData.filter((t) => !t.done_at);
const doneTasksList = tasksData.filter((t) => t.done_at);
const datesData = contact ? await listDates(viewer, contact.id) : [];
const taskAssignees = contact ? await listCrmUsers() : [];

const toLocalInput = (iso: string) => {
  const d = new Date(iso);
  const tz = d.getTimezoneOffset() * 60000;
  return new Date(d.getTime() - tz).toISOString().slice(0, 16);
};
const nowLocal = toLocalInput(new Date().toISOString());
const fmtTime = (iso: string) => new Date(iso).toLocaleTimeString('he-IL', { hour: '2-digit', minute: '2-digit' });
const fmtGregOnly = (iso: string) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(iso);
  return m ? `${Number(m[3])}.${Number(m[2])}.${m[1]}` : '';
};
const ageTurning = (dateIso: string, nextIso: string) => Number(nextIso.slice(0, 4)) - Number(dateIso.slice(0, 4));
const todayStr = todayIso();
const duePillClass = (due: string | null, done: boolean) => {
  if (!due) return '';
  if (done) return 'bg-stone-100 text-stone-500';
  if (due < todayStr) return 'bg-rose-100 text-rose-700';
  if (due === todayStr) return 'bg-amber-100 text-amber-800';
  return 'bg-stone-100 text-stone-600';
};

const activityDrawer = url.searchParams.get('drawer') === 'activity';
const activityEditId = url.searchParams.get('id');
const editingActivity = activityDrawer && activityEditId
  ? timelineData.items.find((a) => a.id === activityEditId) ?? null
  : null;

const tabQs = (t: string) => {
  const p = new URLSearchParams(url.search);
  p.delete('edit');
  p.delete('err');
  p.delete('drawer');
  p.delete('role');
  p.delete('suggest_family');
  p.delete('before');
  p.delete('compose');
  p.delete('id');
  Array.from(p.keys()).filter((k) => k.startsWith('f_')).forEach((k) => p.delete(k));
  p.set('tab', t);
  return `${url.pathname}?${p}`;
};

const employees = contact ? await listEmployees() : [];
const canManageContact = contact ? canManage(viewer, { owner_employee_id: contact.owner?.id ?? null }) : false;
const crmUsers = contact && contact.visibility === 'restricted' && canManageContact ? await listCrmUsers() : [];

const draft = (k: string) => url.searchParams.get(`f_${k}`) || null;
const formValues = contact
  ? {
      first_name: draft('first_name') ?? contact.first_name,
      last_name: draft('last_name') ?? contact.last_name,
      phone: draft('phone') ?? contact.phone_display,
      email: draft('email') ?? contact.email,
      gender: draft('gender') ?? contact.gender,
      birthdate: draft('birthdate') ?? contact.birthdate,
      stage: draft('stage') ?? contact.stage,
      owner_employee_id: draft('owner_employee_id') ?? contact.owner?.id ?? null,
      visibility: draft('visibility') ?? contact.visibility,
      source: draft('source') ?? contact.source,
      notes: draft('notes') ?? contact.notes,
    }
  : {};

const tabs = [
  { key: 'timeline', label: 'ציר זמן', href: tabQs('timeline') },
  { key: 'tasks', label: 'משימות', href: tabQs('tasks') },
  { key: 'gifts', label: 'תרומות', href: tabQs('gifts') },
];

// Group links by type for the "קשרים" card (done here, not inline in the
// template, since a generic type argument on .reduce() inside JSX confuses
// the Astro/esbuild parser).
type ContactLink = NonNullable<typeof contact>['links'][number];
const linksByType: [string, ContactLink[]][] = [];
if (contact) {
  const byType = new Map<string, ContactLink[]>();
  for (const l of contact.links) {
    const list = byType.get(l.type) ?? [];
    list.push(l);
    byType.set(l.type, list);
  }
  linksByType.push(...byType.entries());
}
---
<AppLayout title={contact ? `${contact.first_name} ${contact.last_name} · חב״ד כרמיאל` : 'לא נמצא · חב״ד כרמיאל'} module="crm">
  {!contact ? (
    <div class="card card-body text-center py-10">
      <p class="text-sm text-stone-500">לא נמצא</p>
      <a href="/crm" class="btn btn-outline mt-3 inline-flex">חזרה לרשימת אנשי הקשר</a>
    </div>
  ) : (
    <div class="grid gap-4 lg:grid-cols-[320px_1fr_320px] items-start">
      <!-- ===================== Left: identity + details + sharing ===================== -->
      <div class="space-y-4">
        <div class="card card-body">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-12 h-12 rounded-full bg-accent-soft text-accent-ink grid place-items-center text-base font-semibold shrink-0">
              {initials(contact.first_name, contact.last_name)}
            </div>
            <div class="min-w-0">
              <div class="font-semibold text-stone-900 truncate">{contact.first_name} {contact.last_name}</div>
            </div>
          </div>
          <span class={`pill ${STAGE_STYLES[contact.stage]} mb-3`}>{STAGE_LABELS[contact.stage]}</span>
          <div class="grid grid-cols-5 gap-1 border-t border-stone-100 pt-3">
            <a href={`${tabQs('timeline')}&compose=1#note`} class="flex flex-col items-center gap-1 py-1 rounded-lg hover:bg-stone-50 text-stone-600">
              <StickyNote size={16} /><span class="text-[10px]">הערה</span>
            </a>
            <a href={tabQs('tasks')} class="flex flex-col items-center gap-1 py-1 rounded-lg hover:bg-stone-50 text-stone-600">
              <ListTodo size={16} /><span class="text-[10px]">משימה</span>
            </a>
            {contact.phone ? (
              <a href={telUrl(contact.phone)} class="flex flex-col items-center gap-1 py-1 rounded-lg hover:bg-stone-50 text-stone-600">
                <Phone size={16} /><span class="text-[10px]">שיחה</span>
              </a>
            ) : <div></div>}
            {contact.phone ? (
              <a href={whatsappUrl(contact.phone)} target="_blank" rel="noopener" class="flex flex-col items-center gap-1 py-1 rounded-lg hover:bg-stone-50 text-emerald-600">
                <MessageCircle size={16} /><span class="text-[10px]">וואטסאפ</span>
              </a>
            ) : <div></div>}
            <a href={`${url.pathname}?edit=1`} class="flex flex-col items-center gap-1 py-1 rounded-lg hover:bg-stone-50 text-stone-600">
              <Pencil size={16} /><span class="text-[10px]">עריכה</span>
            </a>
          </div>
        </div>

        <details class="card" open>
          <summary class="card-header cursor-pointer select-none"><span class="card-title">פרטים</span></summary>
          <div class="card-body space-y-3">
            <div>
              <div class="field-label">טלפון</div>
              {contact.phone ? (
                <div class="flex items-center gap-2">
                  <a href={telUrl(contact.phone)} class="field-value hover:text-accent" dir="ltr">{contact.phone_display}</a>
                  <button type="button" class="btn-icon !w-7 !h-7" data-copy={contact.phone_display} title="העתקה"><Copy size={13} /></button>
                </div>
              ) : <div class="field-value text-stone-300">—</div>}
            </div>
            <div>
              <div class="field-label">אימייל</div>
              {contact.email ? <a href={`mailto:${contact.email}`} class="field-value hover:text-accent">{contact.email}</a> : <div class="field-value text-stone-300">—</div>}
            </div>
            <div>
              <div class="field-label">מגדר</div>
              <div class="field-value">{contact.gender === 'male' ? 'זכר' : contact.gender === 'female' ? 'נקבה' : '—'}</div>
            </div>
            <div>
              <div class="field-label">תאריך לידה</div>
              <div class="field-value">{contact.birthdate ? fmtDualDate(contact.birthdate) : '—'}</div>
            </div>
            <div>
              <div class="field-label">משפחה</div>
              <div class="field-value">
                {contact.household ? <a href={`/crm/families/${contact.household.id}`} class="hover:text-accent">{contact.household.name}</a> : '—'}
                {contact.household_role && <span class="text-stone-400"> · {ROLE_LABELS[contact.household_role]}</span>}
              </div>
            </div>
            <div>
              <div class="field-label">תגיות</div>
              <TagPicker client:load contactId={contact.id} tags={allTags} selected={contact.tags.map((t) => t.id)} />
            </div>
            <div>
              <div class="field-label">בעלים</div>
              <form method="POST" action="/api/crm/contacts">
                <input type="hidden" name="_action" value="set_owner" />
                <input type="hidden" name="id" value={contact.id} />
                <input type="hidden" name="back" value={back} />
                <select name="value" onchange="this.form.submit()" class="input !py-1.5 text-sm">
                  <option value="">—</option>
                  {employees.map((e) => <option value={e.id} selected={e.id === contact.owner?.id}>{e.full_name}</option>)}
                </select>
              </form>
            </div>
            <div>
              <div class="field-label">שלב</div>
              <form method="POST" action="/api/crm/contacts">
                <input type="hidden" name="_action" value="set_stage" />
                <input type="hidden" name="id" value={contact.id} />
                <input type="hidden" name="back" value={back} />
                <select name="value" onchange="this.form.submit()" class="input !py-1.5 text-sm">
                  {STAGES.map((s) => <option value={s} selected={s === contact.stage}>{STAGE_LABELS[s]}</option>)}
                </select>
              </form>
            </div>
            <div>
              <div class="field-label">מקור</div>
              <div class="field-value">{contact.source ?? '—'}</div>
            </div>
            <div class="divider"></div>
            <div class="text-xs text-stone-400">
              נוצר על ידי {contact.created_by?.full_name ?? '—'} · {fmtDualDate(contact.created_at, { year: false })}
            </div>
          </div>
        </details>

        <details class="card">
          <summary class="card-header cursor-pointer select-none"><span class="card-title">שיתוף</span></summary>
          <div class="card-body space-y-3">
            {canManageContact ? (
              <form method="POST" action="/api/crm/contacts" class="flex gap-2">
                <input type="hidden" name="_action" value="set_visibility" />
                <input type="hidden" name="id" value={contact.id} />
                <input type="hidden" name="back" value={back} />
                <label class="flex-1 flex items-center gap-2 text-sm border border-stone-300 rounded-lg px-3 py-2 cursor-pointer has-checked:border-accent has-checked:bg-accent-soft">
                  <input type="radio" name="value" value="public" checked={contact.visibility === 'public'} onchange="this.form.submit()" />
                  ציבורי
                </label>
                <label class="flex-1 flex items-center gap-2 text-sm border border-stone-300 rounded-lg px-3 py-2 cursor-pointer has-checked:border-accent has-checked:bg-accent-soft">
                  <input type="radio" name="value" value="restricted" checked={contact.visibility === 'restricted'} onchange="this.form.submit()" />
                  מוגבל
                </label>
              </form>
            ) : (
              <div class="field-value">{contact.visibility === 'public' ? 'ציבורי' : 'מוגבל'}</div>
            )}

            {contact.visibility === 'restricted' && (
              canManageContact ? (
                <form method="POST" action="/api/crm/contacts" class="space-y-2">
                  <input type="hidden" name="_action" value="set_shares" />
                  <input type="hidden" name="id" value={contact.id} />
                  <input type="hidden" name="back" value={back} />
                  <label class="field-label">שיתוף עם</label>
                  <select name="employee_ids[]" multiple class="input h-28">
                    {crmUsers.map((u) => (
                      <option value={u.id} selected={contact.shares.some((s) => s.id === u.id)}>{u.full_name}</option>
                    ))}
                  </select>
                  <button class="btn btn-outline btn-sm w-full">עדכון שיתוף</button>
                </form>
              ) : (
                <div>
                  <div class="field-label">משותף עם</div>
                  <div class="flex flex-wrap gap-1">
                    {contact.shares.length > 0
                      ? contact.shares.map((s) => <span class="chip">{s.full_name}</span>)
                      : <span class="field-value text-stone-300">—</span>}
                  </div>
                </div>
              )
            )}
          </div>
        </details>
      </div>

      <!-- ===================== Center: timeline / tasks / gifts ===================== -->
      <div class="space-y-3 min-w-0">
        <SegmentedTabs items={tabs} active={tab} group="center" />

        <!-- ---------- Timeline ---------- -->
        <div class="card card-body space-y-4" id="note" data-tab-panel="center:timeline" hidden={tab !== 'timeline'}>
          <form method="POST" action="/api/crm/activities" class="space-y-2" data-once>
            <input type="hidden" name="_action" value="add" />
            <input type="hidden" name="contact_id" value={contact.id} />
            <input type="hidden" name="back" value={`${url.pathname}?tab=timeline`} />
            <div class="flex flex-wrap gap-2">
              <select name="kind" class="input !w-32 shrink-0">
                {ACTIVITY_KINDS.filter((k) => k !== 'system').map((k) => (
                  <option value={k} selected={k === 'note'}>{ACTIVITY_LABELS[k]}</option>
                ))}
              </select>
              <input type="datetime-local" name="occurred_at" class="input flex-1 min-w-[10rem]" value={nowLocal} />
            </div>
            <textarea name="body" rows="2" required class="input" placeholder="מה קרה?" autofocus={compose}></textarea>
            <button class="btn btn-primary btn-sm" data-submit>הוספה</button>
          </form>

          <div class="divider"></div>

          {contact.notes && (
            <div class="bg-stone-50 border border-stone-100 rounded-lg px-3 py-2">
              <div class="field-label">הערות כלליות</div>
              <p class="text-sm text-stone-700 whitespace-pre-wrap">{contact.notes}</p>
            </div>
          )}

          {timelineData.items.length === 0 ? (
            <p class="text-sm text-stone-400 text-center py-6">אין עדיין פעילות</p>
          ) : (
            <div class="space-y-3">
              {timelineData.items.map((a) => {
                const Icon = ACTIVITY_ICONS[a.kind] ?? StickyNote;
                const canEdit = a.kind !== 'system' && (viewer.role === 'admin' || a.created_by?.id === viewer.employeeId);
                return (
                  <div class="flex gap-3">
                    <div class={`w-8 h-8 rounded-full grid place-items-center shrink-0 ${a.kind === 'system' ? 'bg-stone-100 text-stone-400' : 'bg-accent-soft text-accent-ink'}`}>
                      <Icon size={15} />
                    </div>
                    <div class="flex-1 min-w-0 space-y-0.5">
                      <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2 text-xs text-stone-400 min-w-0">
                          <span class="font-medium text-stone-600 shrink-0">{ACTIVITY_LABELS[a.kind]}</span>
                          <span class="shrink-0">·</span>
                          <span class="truncate">{fmtDualDate(a.occurred_at, { year: false })} · {fmtTime(a.occurred_at)}</span>
                        </div>
                        {canEdit && (
                          <div class="relative shrink-0">
                            <button type="button" id={`act-menu-btn-${a.id}`} popovertarget={`act-menu-${a.id}`} class="btn-icon !w-7 !h-7" aria-haspopup="menu" title="פעולות">
                              <MoreVertical size={14} />
                            </button>
                            <div id={`act-menu-${a.id}`} popover class="fixed" data-anchor={`act-menu-btn-${a.id}`} data-place="below">
                              <div class="menu" role="menu">
                                <a href={`${url.pathname}?tab=timeline&drawer=activity&id=${a.id}`} class="menu-item" role="menuitem">
                                  <Pencil size={14} class="text-stone-400" /> עריכה
                                </a>
                                <form method="POST" action="/api/crm/activities" onsubmit="return confirm('למחוק את הפעילות?')">
                                  <input type="hidden" name="_action" value="delete" />
                                  <input type="hidden" name="id" value={a.id} />
                                  <input type="hidden" name="back" value={`${url.pathname}?tab=timeline`} />
                                  <button type="submit" class="menu-item text-rose-600" role="menuitem"><Trash2 size={14} /> מחיקה</button>
                                </form>
                              </div>
                            </div>
                          </div>
                        )}
                      </div>
                      {a.kind === 'system' ? (
                        <p class="text-sm text-stone-500">{describeSystemEvent(a.meta)}</p>
                      ) : (
                        <p class="text-sm text-stone-800 whitespace-pre-wrap">{a.body}</p>
                      )}
                      <div class="text-[11px] text-stone-400">{a.created_by?.full_name ?? '—'}</div>
                    </div>
                  </div>
                );
              })}
            </div>
          )}

          {timelineData.next && (
            <div class="text-center pt-1">
              <a href={`${url.pathname}?tab=timeline&before=${encodeURIComponent(timelineData.next)}`} class="text-xs text-stone-500 hover:text-accent">עוד</a>
            </div>
          )}
        </div>

        <!-- ---------- Tasks ---------- -->
        <div class="card card-body space-y-4" data-tab-panel="center:tasks" hidden={tab !== 'tasks'}>
          <form method="POST" action="/api/crm/tasks" class="flex flex-wrap gap-2" data-once>
            <input type="hidden" name="_action" value="create" />
            <input type="hidden" name="contact_id" value={contact.id} />
            <input type="hidden" name="back" value={`${url.pathname}?tab=tasks`} />
            <input type="text" name="title" required placeholder="משימה חדשה…" class="input flex-1 min-w-[10rem]" />
            <input type="date" name="due_date" class="input !w-36" />
            <select name="assignee_employee_id" class="input !w-40">
              {taskAssignees.map((u) => <option value={u.id} selected={u.id === viewer.employeeId}>{u.full_name}</option>)}
            </select>
            <button class="btn btn-primary btn-sm" data-submit>הוספה</button>
          </form>

          <div class="divider"></div>

          {openTasksList.length === 0 && doneTasksList.length === 0 ? (
            <p class="text-sm text-stone-400 text-center py-6">אין משימות</p>
          ) : (
            <div class="space-y-2">
              {openTasksList.length === 0 ? (
                <p class="text-xs text-stone-400">אין משימות פתוחות</p>
              ) : openTasksList.map((t) => (
                <div class="flex items-center gap-2.5">
                  <form method="POST" action="/api/crm/tasks">
                    <input type="hidden" name="_action" value="toggle" />
                    <input type="hidden" name="id" value={t.id} />
                    <input type="hidden" name="back" value={`${url.pathname}?tab=tasks`} />
                    <input type="hidden" name="done" value="1" />
                    <button type="submit" class="w-5 h-5 rounded-md border-2 border-stone-300 hover:border-accent shrink-0" title="סימון כהושלם"></button>
                  </form>
                  <div class="flex-1 min-w-0 text-sm text-stone-900 truncate">{t.title}</div>
                  {t.due_date && <span class={`pill shrink-0 ${duePillClass(t.due_date, false)}`}>{fmtDualDate(t.due_date, { year: false })}</span>}
                  <span class="text-xs text-stone-400 shrink-0">{t.assignee?.full_name ?? '—'}</span>
                </div>
              ))}
            </div>
          )}

          {doneTasksList.length > 0 && (
            <details class="pt-1">
              <summary class="text-xs text-stone-500 cursor-pointer select-none">הושלמו ({doneTasksList.length})</summary>
              <div class="space-y-2 pt-2">
                {doneTasksList.map((t) => (
                  <div class="flex items-center gap-2.5 opacity-60">
                    <form method="POST" action="/api/crm/tasks">
                      <input type="hidden" name="_action" value="toggle" />
                      <input type="hidden" name="id" value={t.id} />
                      <input type="hidden" name="back" value={`${url.pathname}?tab=tasks`} />
                      <input type="hidden" name="done" value="0" />
                      <button type="submit" class="w-5 h-5 rounded-md bg-accent border-2 border-accent grid place-items-center shrink-0" title="ביטול סימון">
                        <Check size={12} class="text-white" />
                      </button>
                    </form>
                    <div class="flex-1 min-w-0 text-sm text-stone-500 line-through truncate">{t.title}</div>
                    {t.due_date && <span class="pill shrink-0 bg-stone-100 text-stone-500">{fmtDualDate(t.due_date, { year: false })}</span>}
                    <span class="text-xs text-stone-400 shrink-0">{t.assignee?.full_name ?? '—'}</span>
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>

        <div class="card card-body" data-tab-panel="center:gifts" hidden={tab !== 'gifts'}>
          <p class="text-sm text-stone-400 text-center py-6">בשלב הבא</p>
        </div>
      </div>

      <!-- ===================== Right: associations ===================== -->
      <div class="space-y-4">
        {suggestFamilyId && (
          <div class="card card-body bg-amber-50 border-amber-200 space-y-2">
            <p class="text-sm text-amber-900">לאחד למשפחה אחת?</p>
            <form method="POST" action="/api/crm/households" class="flex gap-2">
              <input type="hidden" name="_action" value="merge_spouse" />
              <input type="hidden" name="contact_id" value={contact.id} />
              <input type="hidden" name="other_id" value={suggestFamilyId} />
              <input type="hidden" name="back" value={url.pathname} />
              <button class="btn btn-primary btn-sm flex-1">איחוד למשפחה</button>
              <a href={url.pathname} class="btn btn-outline btn-sm">לא כעת</a>
            </form>
          </div>
        )}

        <div class="card">
          <div class="card-header flex-wrap gap-1.5">
            <span class="card-title flex items-center gap-1.5"><Users size={14} class="text-stone-400" /> משפחה</span>
            <div class="flex items-center gap-1.5">
              <a href={`${url.pathname}?drawer=member&role=spouse`} class="btn btn-ghost btn-sm"><Plus size={13} /> בן/בת זוג</a>
              <a href={`${url.pathname}?drawer=member&role=child`} class="btn btn-ghost btn-sm"><Plus size={13} /> ילד/ה</a>
            </div>
          </div>
          <div class="card-body space-y-2">
            {family ? (
              <>
                <a href={`/crm/families/${family.id}`} class="font-medium text-sm text-stone-900 hover:text-accent">{family.name}</a>
                {(family.street || family.city) && (
                  <div class="text-xs text-stone-500">{[family.street, family.city].filter(Boolean).join(', ')}</div>
                )}
                <div class="space-y-1.5 pt-1">
                  {family.members.filter((m) => m.id !== contact.id).map((m) => (
                    <div class="flex items-center justify-between text-sm">
                      <a href={`/crm/contacts/${m.id}`} class="hover:text-accent truncate">{m.first_name} {m.last_name}</a>
                      <div class="flex items-center gap-1.5 shrink-0">
                        {m.household_role && <span class="pill bg-stone-100 text-stone-600">{ROLE_LABELS[m.household_role] ?? m.household_role}</span>}
                        {m.birthdate && <span class="text-[11px] text-stone-400">{fmtDualDate(m.birthdate, { year: false })}</span>}
                      </div>
                    </div>
                  ))}
                </div>
                <a href={`${url.pathname}?drawer=family`} class="text-xs text-stone-500 hover:text-accent inline-flex items-center gap-1 pt-1">
                  <ArrowRightLeft size={12} /> העברה למשפחה אחרת
                </a>
              </>
            ) : (
              <>
                <p class="text-xs text-stone-400">איש הקשר אינו משויך למשפחה</p>
                <a href={`${url.pathname}?drawer=family`} class="text-xs text-stone-500 hover:text-accent inline-flex items-center gap-1">
                  <ArrowRightLeft size={12} /> שיוך למשפחה קיימת
                </a>
              </>
            )}
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title flex items-center gap-1.5"><Link2 size={14} class="text-stone-400" /> קשרים ({contact.links.length})</span>
            <a href={`${url.pathname}?drawer=link`} class="btn btn-ghost btn-sm"><Plus size={13} /> הוספת קשר</a>
          </div>
          <div class="card-body space-y-2">
            {contact.links.length === 0 ? (
              <p class="text-xs text-stone-400">אין קשרים רשומים</p>
            ) : linksByType.map(([type, links]) => (
                <div>
                  <div class="text-xs text-stone-400 mb-1">{LINK_LABELS[type as keyof typeof LINK_LABELS]}</div>
                  <div class="space-y-1">
                    {links.map((l) => (
                      <div class="flex items-center justify-between gap-2 text-sm">
                        <div class="min-w-0">
                          <a href={`/crm/contacts/${l.contact.id}`} class="hover:text-accent">
                            {l.contact.first_name} {l.contact.last_name}
                          </a>
                          {l.note && <span class="text-xs text-stone-400"> · {l.note}</span>}
                        </div>
                        <form method="POST" action="/api/crm/links" onsubmit="return confirm('להסיר את הקשר?')">
                          <input type="hidden" name="_action" value="remove" />
                          <input type="hidden" name="id" value={l.id} />
                          <input type="hidden" name="back" value={url.pathname} />
                          <button type="submit" class="btn-icon !w-6 !h-6 shrink-0" title="הסרה"><X size={13} /></button>
                        </form>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title flex items-center gap-1.5"><Gift size={14} class="text-stone-400" /> תרומות ({contact.gift_count})</span>
            <button type="button" class="btn btn-ghost btn-sm" disabled title="בקרוב"><Plus size={13} /> הוספה</button>
          </div>
          <div class="card-body">
            <div class="text-lg font-semibold text-stone-900">{fmtMoney(contact.gift_total)}</div>
            <div class="text-xs text-stone-400">{contact.gift_count} תרומות</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title flex items-center gap-1.5"><ListChecks size={14} class="text-stone-400" /> משימות פתוחות ({openTasksList.length})</span>
            <a href={tabQs('tasks')} class="btn btn-ghost btn-sm"><Plus size={13} /> הוספה</a>
          </div>
          <div class="card-body space-y-1.5">
            {openTasksList.length === 0 ? (
              <p class="text-xs text-stone-400">אין משימות פתוחות</p>
            ) : (
              <>
                {openTasksList.slice(0, 3).map((t) => (
                  <div class="text-sm text-stone-700 truncate">{t.title}</div>
                ))}
                <a href={tabQs('tasks')} class="text-xs text-stone-500 hover:text-accent inline-block pt-1">כל המשימות</a>
              </>
            )}
          </div>
        </div>

        <div class="card">
          <div class="card-header">
            <span class="card-title flex items-center gap-1.5"><CalendarDays size={14} class="text-stone-400" /> תאריכים</span>
            <a href={`${url.pathname}?drawer=date`} class="btn btn-ghost btn-sm"><Plus size={13} /> הוספה</a>
          </div>
          <div class="card-body space-y-3">
            {datesData.length === 0 ? (
              <p class="text-xs text-stone-400">אין תאריכים נוספים</p>
            ) : datesData.map((d) => (
              <div class="flex items-start justify-between gap-2 text-sm">
                <div class="min-w-0">
                  <div class="text-xs text-stone-400">{DATE_KIND_LABELS[d.kind]}{d.label ? ` · ${d.label}` : ''}</div>
                  <div class="font-medium text-stone-900">{d.hebrew}</div>
                  <div class="text-xs text-stone-500">{fmtGregOnly(d.date)}</div>
                  <div class="text-[11px] text-stone-400">
                    הבא: {fmtDualDate(d.next)}
                    {d.kind === 'birthday' && ` · בן/בת ${ageTurning(d.date, d.next)}`}
                  </div>
                </div>
                {d.id === 'birthdate' ? (
                  <a href={`${url.pathname}?edit=1`} class="btn-icon !w-7 !h-7 shrink-0" title="עריכה"><Pencil size={13} /></a>
                ) : (
                  <form method="POST" action="/api/crm/dates" onsubmit="return confirm('למחוק את התאריך?')">
                    <input type="hidden" name="_action" value="delete" />
                    <input type="hidden" name="id" value={d.id} />
                    <input type="hidden" name="back" value={url.pathname} />
                    <button type="submit" class="btn-icon !w-7 !h-7 shrink-0" title="מחיקה"><Trash2 size={13} /></button>
                  </form>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  {contact && editing && (
    <Drawer title="עריכת איש קשר" closeHref={url.pathname} size="md">
      <ContactForm
        employees={employees}
        values={formValues}
        action="update"
        id={contact.id}
        back={url.pathname}
        err={err}
      />
    </Drawer>
  )}

  {contact && memberDrawer && (
    <Drawer title={memberRole === 'spouse' ? 'הוספת בן/בת זוג' : 'הוספת ילד/ה'} closeHref={url.pathname}>
      {err && <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl px-4 py-3 mb-4">{err}</div>}
      <form method="POST" action="/api/crm/households" class="space-y-4">
        <input type="hidden" name="_action" value="add_member" />
        <input type="hidden" name="contact_id" value={contact.id} />
        <input type="hidden" name="household_role" value={memberRole} />
        <input type="hidden" name="back" value={url.pathname} />
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="field-label">שם פרטי *</label>
            <input type="text" name="first_name" required class="input" />
          </div>
          <div>
            <label class="field-label">שם משפחה</label>
            <input type="text" name="last_name" class="input" value={family?.name?.replace(/^משפחת\s+/, '') ?? contact.last_name} />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="field-label">טלפון</label>
            <input type="tel" name="phone" class="input" placeholder="050-123 4567" />
          </div>
          <div>
            <label class="field-label">אימייל</label>
            <input type="email" name="email" class="input" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="field-label">מגדר</label>
            <select name="gender" class="input">
              <option value="">—</option>
              <option value="male">זכר</option>
              <option value="female">נקבה</option>
            </select>
          </div>
          <div>
            <label class="field-label">תאריך לידה</label>
            <input type="date" name="birthdate" class="input" />
          </div>
        </div>
        <button class="btn btn-primary w-full">הוספה</button>
      </form>
    </Drawer>
  )}

  {contact && familyDrawer && (
    <Drawer title="שיוך למשפחה" closeHref={url.pathname}>
      {err && <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl px-4 py-3 mb-4">{err}</div>}
      <form method="POST" action="/api/crm/households" class="space-y-4">
        <input type="hidden" name="_action" value="set_family" />
        <input type="hidden" name="contact_id" value={contact.id} />
        <input type="hidden" name="back" value={url.pathname} />
        <div>
          <label class="field-label">משפחה</label>
          <FamilyPicker
            client:load
            name="household_id"
            placeholder="חיפוש משפחה…"
            initialId={family?.id ?? ''}
            initialLabel={family?.name ?? ''}
          />
        </div>
        <div>
          <label class="field-label">תפקיד במשפחה</label>
          <select name="household_role" class="input">
            {HOUSEHOLD_ROLES.map((r) => <option value={r} selected={r === (contact.household_role ?? 'other')}>{ROLE_LABELS[r]}</option>)}
          </select>
        </div>
        <button class="btn btn-primary w-full">שיוך</button>
      </form>
      {family && (
        <form method="POST" action="/api/crm/households" class="pt-3 mt-3 border-t border-stone-200">
          <input type="hidden" name="_action" value="set_family" />
          <input type="hidden" name="contact_id" value={contact.id} />
          <input type="hidden" name="household_id" value="" />
          <input type="hidden" name="back" value={url.pathname} />
          <button
            class="btn btn-danger w-full"
            onclick="if(!confirm('להסיר את איש הקשר מהמשפחה?')) return false;"
          >
            הסרה מהמשפחה
          </button>
        </form>
      )}
    </Drawer>
  )}

  {contact && linkDrawer && (
    <Drawer title="הוספת קשר" closeHref={url.pathname}>
      {err && <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl px-4 py-3 mb-4">{err}</div>}
      <form method="POST" action="/api/crm/links" class="space-y-4">
        <input type="hidden" name="_action" value="add" />
        <input type="hidden" name="from_id" value={contact.id} />
        <input type="hidden" name="back" value={url.pathname} />
        <div>
          <label class="field-label">איש קשר</label>
          <ContactPicker client:load name="to_id" placeholder="חיפוש איש קשר…" exclude={contact.id} />
        </div>
        <div>
          <label class="field-label">סוג הקשר</label>
          <select name="type" class="input">
            {LINK_TYPES.map((t) => (
              <option value={t}>{contact.first_name} הוא/היא {LINK_LABELS[t]} של</option>
            ))}
          </select>
        </div>
        <div>
          <label class="field-label">הערה</label>
          <input type="text" name="note" class="input" />
        </div>
        <button class="btn btn-primary w-full">הוספת קשר</button>
      </form>
    </Drawer>
  )}

  {contact && editingActivity && (
    <Drawer title="עריכת פעילות" closeHref={`${url.pathname}?tab=timeline`}>
      {err && <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl px-4 py-3 mb-4">{err}</div>}
      <form method="POST" action="/api/crm/activities" class="space-y-4">
        <input type="hidden" name="_action" value="update" />
        <input type="hidden" name="id" value={editingActivity.id} />
        <input type="hidden" name="back" value={`${url.pathname}?tab=timeline`} />
        <div>
          <label class="field-label">סוג</label>
          <select name="kind" class="input">
            {ACTIVITY_KINDS.filter((k) => k !== 'system').map((k) => (
              <option value={k} selected={k === editingActivity.kind}>{ACTIVITY_LABELS[k]}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="field-label">מתי</label>
          <input type="datetime-local" name="occurred_at" class="input" value={toLocalInput(editingActivity.occurred_at)} />
        </div>
        <div>
          <label class="field-label">תוכן</label>
          <textarea name="body" rows="4" required class="input">{editingActivity.body}</textarea>
        </div>
        <button class="btn btn-primary w-full">שמירה</button>
      </form>
    </Drawer>
  )}

  {contact && dateDrawer && (
    <Drawer title="הוספת תאריך" closeHref={url.pathname}>
      {err && <div class="bg-rose-50 border border-rose-200 text-rose-800 text-sm rounded-xl px-4 py-3 mb-4">{err}</div>}
      <form method="POST" action="/api/crm/dates" class="space-y-4">
        <input type="hidden" name="_action" value="add" />
        <input type="hidden" name="contact_id" value={contact.id} />
        <input type="hidden" name="back" value={url.pathname} />
        <div>
          <label class="field-label">סוג</label>
          <select name="kind" class="input">
            {DATE_KINDS.map((k) => <option value={k}>{DATE_KIND_LABELS[k]}</option>)}
          </select>
        </div>
        <div>
          <HebrewDatePicker client:load name="date" label="תאריך" required />
        </div>
        <div>
          <label class="field-label">תווית</label>
          <input type="text" name="label" class="input" placeholder="לדוגמה: יארצייט אבא" />
        </div>
        <button class="btn btn-primary w-full">הוספה</button>
      </form>
    </Drawer>
  )}

  <script is:inline>
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const v = btn.getAttribute('data-copy');
        if (v) navigator.clipboard?.writeText(v).catch(() => {});
      });
    });
  </script>
</AppLayout>
